# mcp-abap-rfc 的 env 文件示例：只走 RFC（含经 SAProuter），不需要也不接受 SAP_URL。
# 复制为你自己的文件（权限 600，不要提交），用 --env-path=<文件> 启动。
# 只支持整行注释（# 开头），不支持行内注释。
# 同一个键：env 文件里写了就以文件为准（即使值为空）；文件没提到的键才从 shell 环境补。

# 应用服务器：只写主机名或 IP（SAP Logon 的「应用服务器」），不带 http:// 和端口
SAP_ASHOST=your-sap-host.example.com
# 实例号：两位数字（SAP Logon 的「实例编号」），必填，不默认 00
SAP_SYSNR=00
# 默认集团
SAP_CLIENT=800

# 可选：同一系统的多个集团（必须包含上面的 SAP_CLIENT）。配置后每个工具多一个可选参数 sap_client
# SAP_CLIENTS=100,800
# 可选：某个集团用别的账号时，账号和密码要成对填写（<n> 是集团号）
# SAP_CLIENT_100_USERNAME=
# SAP_CLIENT_100_PASSWORD=

# 用户名大小写须与系统 USR02 一致（通常大写），否则创建对象时会报 PAK049
SAP_USERNAME=YOUR_USER
SAP_PASSWORD=

# RFC 登录语言，缺省为 EN。新建对象的原始语言（TADIR-MASTERLANG）就是它；
# 想要英文原始语言就写 EN。
SAP_LANGUAGE=EN

# 可选：只能经 SAProuter 访问的系统，router 串与 SAP GUI 中填写的一致
# SAP_SAPROUTER=/H/1.2.3.4/H/
# 可选：设为 on 恢复 RFC 压缩（默认关闭；开启时大的 base64 请求会在服务器上 dump XML_FORMAT_ERROR）
# SAP_RFC_COMPRESSION=on

# 系统类型：onprem（默认）或 legacy（BASIS < 7.50）；不接受 cloud。命令行 --system-type 优先于本文件
# SAP_SYSTEM_TYPE=onprem

# 部分系统在创建/修改对象时需要指定系统上下文（可选）
# SAP_MASTER_SYSTEM=DEV
# SAP_RESPONSIBLE=YOUR_USER

# 以下开关均默认关闭；和上面的键一样，文件里写了就以文件为准（即使值为空），没写才看 shell
# 请求超时（毫秒）：默认 45000 / 长请求 60000 / CSRF 15000
# SAP_TIMEOUT_DEFAULT=45000
# SAP_TIMEOUT_LONG=60000
# SAP_TIMEOUT_CSRF=15000
# 单个工具结果的字符数上限（1..500000；命令行 --max-result-chars 优先于本文件；值不合法则拒绝启动）
# MCP_MAX_RESULT_CHARS=200000
# 禁用指定工具（逗号分隔，支持 * 通配），例如禁止一切 Delete 类工具
# SAP_DENY_TOOLS=Delete*
# 限制 Create* 类工具的目标包（逗号分隔，支持 * 通配）——只管 package_name 参数，
# 不管已存在对象的 Update/Delete/Activate，详见 CLAUDE.md
# SAP_ALLOWED_PACKAGES=Z*,$TMP
# 审计日志文件路径（JSONL，每次工具调用一行；自动脱敏密码/token/cookie 等字段）
# SAP_AUDIT_LOG_FILE=/var/log/mcp-abap-rfc/audit.jsonl
# NW RFC SDK 的 trace / dev_rfc.log 目录（默认 <系统临时目录>/mcp-abap-rfc-rfc-trace，不写进当前目录）
# RFC_TRACE_DIR=/var/tmp/mcp-abap-rfc-trace

# 以下键可不写；写了的话值必须是下面这样，否则拒绝启动：
# SAP_CONNECTION_TYPE=rfc
# SAP_AUTH_TYPE=basic
