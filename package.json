{
  "name": "mcp-abap-rfc",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:unit": "jest --config jest.unit.config.cjs --runInBand",
    "test:check": "npx tsc --noEmit -p tsconfig.test.json",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "lint": "npx biome check --write src",
    "lint:check": "npx biome check src",
    "format": "npx biome format --write src",
    "build": "npx biome check --write --diagnostic-level=error src && npx tsc -p tsconfig.json && npm run prune:dist",
    "prune:dist": "node scripts/prune-dist.mjs",
    "build:fast": "npx tsc -p tsconfig.json",
    "check-todos": "node tools/check-todos.js",
    "install:mcp": "node scripts/install-mcp.js",
    "start": "node ./bin/mcp-abap-rfc.js",
    "dev": "npm run build && npx @modelcontextprotocol/inspector node ./dist/server/launcher.js",
    "clean": "make clean",
    "chrono": "./tools/version-stats.sh",
    "docs:tools": "node ./tools/generate-tools-docs.js",
    "prepublishOnly": "npm run build",
    "package": "npm pack",
    "package:build": "npm run build && npm pack",
    "prepare": "husky",
    "setup:rfc": "node scripts/setup-rfc.mjs"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "rfc",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "saprouter",
    "crud"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "description": "SAP ABAP development tools over RFC (SAP NW RFC SDK, SAProuter), as a stdio MCP server",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-util": "^30.3.0",
    "lint-staged": "^16.4.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.2.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@abaplint/core": "^2.120.57",
    "@mcp-abap-adt/adt-clients": "^5.6.0",
    "@mcp-abap-adt/connection": "^1.9.1",
    "@mcp-abap-adt/interfaces": "^7.2.0",
    "@mcp-abap-adt/logger": "^0.1.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "fast-xml-parser": "^5.5.10",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@mcp-abap-adt/sap-rfc-lite": "0.1.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "mcp-abap-rfc": "./bin/mcp-abap-rfc.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/index.ts"
    ],
    "testPathIgnorePatterns": [
      "__tests__/admin/",
      "__tests__/integration/"
    ],
    "maxWorkers": 1,
    "testTimeout": 600000
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "biome check --write"
    ]
  },
  "private": false
}
